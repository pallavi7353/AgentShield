# Copy this file to .env and fill in real values before running.
# NEVER commit the actual .env file to git.

# --- Database ---
# SQLite (default, zero-setup, good for hackathon demo):
DATABASE_URL=sqlite:///./ai_agent_security.db
# PostgreSQL (production-style):
# DATABASE_URL=postgresql://username:password@localhost:5432/ai_agent_security

# --- JWT Auth ---
SECRET_KEY=replace_this_with_a_long_random_secret_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Session / Security Policy ---
SESSION_TIMEOUT_MINUTES=30
MAX_FAILED_LOGIN_ATTEMPTS=5
FAILED_LOGIN_LOCK_MINUTES=15

# --- Threat Detection ---
HIGH_RISK_SCORE_THRESHOLD=70
